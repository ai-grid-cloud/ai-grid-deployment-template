# The hands-off install's choices (make install). Copy this file to
# install.env, set the values and commit it. It holds no secrets: each *_FILE
# names a file under the git-ignored .config/, which you or your CI job fill.

# The library revision to pin: a branch, a tag or a full commit SHA, which
# scripts/set-library.sh resolves to a SHA. Empty keeps the template's pin.
LIBRARY_REVISION=

# The catalog repository the provider console writes models and subscriptions to.
CATALOG_REPO_URL=REQUIRED-catalogRepoURL

# A token that can push to this deployment repository (scripts/git-push.sh).
DEPLOYMENT_TOKEN_FILE=.config/deployment-token
# A token that can write the catalog repository (the console's git writer).
CATALOG_TOKEN_FILE=.config/catalog-token
# A registry auth file with a quay.io/rhoai login, for the nightly OpenShift AI.
QUAY_AUTH_FILE=.config/quay-auth.json

# Use an existing component instead of installing one. Only "install" is
# supported in this version; any other value stops the install with "not
# supported yet".
# KEYCLOAK=install

# SITE_ISSUER_<NAME>: the DNS-01 ClusterIssuer for site NAME's MaaS certificate (name upper-cased, - becomes _; needed only when an ingress or combined site has several DNS-01 ClusterIssuers), e.g. SITE_ISSUER_SITE_B=letsencrypt-dns
