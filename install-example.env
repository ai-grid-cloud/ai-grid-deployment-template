# The hands-off install's choices (make install). Copy this file to
# install.env, set the values and commit it. It holds no secrets: each *_FILE
# names a file under the git-ignored .config/, which you or your CI job fill.
#
# Precedence: a value set here, even an empty one, wins over the same variable
# in your environment; a key that's absent or commented out here takes the
# environment's value, and else the default shown. Relative paths are relative
# to this repository; ~/ is your home. A key not listed below stops the install
# (a typo, most likely), and so does any value still starting with REQUIRED-.

# The library revision to pin: a branch, a tag or a full commit SHA, which
# scripts/set-library.sh resolves to a SHA. Empty keeps the template's pin.
LIBRARY_REVISION=

# The catalog repository the provider console writes models and subscriptions to.
CATALOG_REPO_URL=REQUIRED-catalogRepoURL

# A token that can push to this deployment repository (scripts/git-push.sh).
DEPLOYMENT_TOKEN_FILE=.config/deployment-token
# A token that can write the catalog repository (the console's git writer).
CATALOG_TOKEN_FILE=.config/catalog-token
# A registry auth file with a quay.io/rhoai login, for the nightly OpenShift AI.
QUAY_AUTH_FILE=.config/quay-auth.json

# Optional. Uncomment a line to change it; each shows its default.

# Use an existing component instead of installing one. Only "install" is
# supported in this version; any other value stops the install with "not
# supported yet".
# KEYCLOAK=install

# 1 lets bootstrap use a general quay.io login from QUAY_AUTH_FILE when it has
# no quay.io/rhoai entry. Default: empty (the quay.io/rhoai entry is required).
# ALLOW_GENERIC_LOGIN=

# The lifetime of the provider-admin token make install writes to
# .config/provider-admin-token (scripts/provider-admin.sh).
# PROVIDER_ADMIN_TOKEN_DURATION=168h

# SITE_ISSUER_<NAME>: the DNS-01 ClusterIssuer for site NAME's MaaS certificate,
# the name upper-cased with - as _. Needed only when an ingress or combined site
# has several DNS-01 ClusterIssuers. No default.
# SITE_ISSUER_SITE_B=letsencrypt-dns

# Gate time limits, in whole seconds (scripts/gates.sh). Each gate stops the
# install when its condition isn't met in time.
# GATE_ROOT_SECONDS=600         # deployment-root Synced at the pushed commit (hub-root, hub-root-sites)
# GATE_MCH_SECONDS=1800         # the MultiClusterHub Running (hub-acm)
# GATE_HUB_APPS_SECONDS=3600    # every hub Application Synced and Healthy (hub-apps, hub-apps-final)
# GATE_SITE_IMPORT_SECONDS=900  # each site's import (site-NAME-import)
# GATE_READY_SECONDS=600        # scripts/ready-check.sh passes, rerun until then (ready)
# GATE_INTERVAL=15              # seconds between a gate's checks
# GATE_ERROR_LIMIT=4            # consecutive oc errors before a gate fails
# Defined in scripts/gates.sh but not waited on by make install in this version:
# GATE_O11Y_SECONDS=2700
# GATE_TENANT_IDP_SECONDS=1800
